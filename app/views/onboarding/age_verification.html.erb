<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4">
  <div class="max-w-md w-full space-y-8">
    <!-- Progress indicator -->
    <div class="flex items-center justify-center space-x-2 mb-8">
      <div class="h-2 w-8 bg-indigo-600 rounded-full"></div>
      <div class="h-2 w-8 bg-gray-300 rounded-full"></div>
      <div class="h-2 w-8 bg-gray-300 rounded-full"></div>
      <div class="h-2 w-8 bg-gray-300 rounded-full"></div>
    </div>

    <div class="text-center">
      <div class="mx-auto h-16 w-16 bg-indigo-600 rounded-full flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Age Verification</h1>
      <p class="text-lg text-gray-600 mb-8">You must be 18 or older to participate in lottery games.</p>
    </div>

    <div class="bg-white rounded-lg shadow-lg p-8">
      <%= form_with url: onboarding_age_verification_path, method: :post, local: true, class: "space-y-6" do |form| %>
        <div>
          <label for="date_of_birth" class="block text-sm font-medium text-gray-700 mb-2">
            Date of Birth
          </label>
          <input type="date" 
                 id="date_of_birth" 
                 name="date_of_birth" 
                 value="<%= current_user&.date_of_birth&.strftime('%Y-%m-%d') %>"
                 max="<%= Date.current.strftime('%Y-%m-%d') %>"
                 required
                 class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
          <p class="mt-2 text-sm text-gray-500">
            We need to verify that you're at least 18 years old to comply with gaming regulations.
          </p>
        </div>

        <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-yellow-800">
                Age Requirement
              </h3>
              <div class="mt-2 text-sm text-yellow-700">
                <p>You must be at least 18 years old to create an account and participate in lottery games. This is required by law in most jurisdictions.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex space-x-4">
          <%= link_to "Back", onboarding_path, 
                      class: "flex-1 flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out" %>
          
          <%= form.submit "Continue", 
                          class: "flex-1 flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out" %>
        </div>
      <% end %>
    </div>

    <div class="text-center">
      <p class="text-xs text-gray-500">
        Your personal information is encrypted and secure. We comply with all privacy regulations.
      </p>
    </div>
  </div>
</div>
