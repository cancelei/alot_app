<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4">
  <div class="max-w-2xl w-full space-y-8">
    <!-- Progress indicator -->
    <div class="flex items-center justify-center space-x-2 mb-8">
      <div class="h-2 w-8 bg-indigo-600 rounded-full"></div>
      <div class="h-2 w-8 bg-indigo-600 rounded-full"></div>
      <div class="h-2 w-8 bg-indigo-600 rounded-full"></div>
      <div class="h-2 w-8 bg-indigo-600 rounded-full"></div>
    </div>

    <div class="text-center">
      <div class="mx-auto h-16 w-16 bg-indigo-600 rounded-full flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">How to Play</h1>
      <p class="text-lg text-gray-600 mb-8">Learn the basics of lottery games and how to maximize your chances.</p>
    </div>

    <div class="bg-white rounded-lg shadow-lg p-8">
      <div class="space-y-8">
        <!-- Step 1 -->
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
              <span class="text-indigo-600 font-semibold">1</span>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Choose Your Numbers</h3>
            <p class="text-gray-600 mb-3">Select your lucky numbers or use Quick Pick for random selection. Most lotteries require you to pick 5-6 numbers from a range (e.g., 1-49).</p>
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500">Example:</span>
                <div class="flex space-x-2">
                  <span class="inline-flex items-center justify-center h-8 w-8 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">7</span>
                  <span class="inline-flex items-center justify-center h-8 w-8 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">14</span>
                  <span class="inline-flex items-center justify-center h-8 w-8 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">21</span>
                  <span class="inline-flex items-center justify-center h-8 w-8 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">35</span>
                  <span class="inline-flex items-center justify-center h-8 w-8 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">42</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
              <span class="text-indigo-600 font-semibold">2</span>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Purchase Your Ticket</h3>
            <p class="text-gray-600 mb-3">Review your numbers, choose how many draws to enter, and complete your purchase securely.</p>
            <div class="bg-green-50 border border-green-200 rounded-lg p-3">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                <span class="text-sm text-green-700">All transactions are encrypted and secure</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
              <span class="text-indigo-600 font-semibold">3</span>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Wait for the Draw</h3>
            <p class="text-gray-600 mb-3">Draws happen regularly (usually weekly). You'll be notified automatically when results are available.</p>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-blue-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM4.828 7l2.828-2.828A4 4 0 019.071 3.343L9.414 3H12a4 4 0 014 4v.343l.657.657a4 4 0 010 5.657l-.657.657A4 4 0 0112 17H9.414l-.343-.343A4 4 0 017.657 15.3L4.828 12.5A4 4 0 013 9.172V7a4 4 0 011.828 0z"></path>
                </svg>
                <span class="text-sm text-blue-700">Get instant notifications for draw results</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
              <span class="text-indigo-600 font-semibold">4</span>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Claim Your Prizes</h3>
            <p class="text-gray-600 mb-3">Winnings are automatically credited to your account. Large prizes may require additional verification.</p>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-yellow-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
                <span class="text-sm text-yellow-700">Prizes over $600 require identity verification</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tips Section -->
      <div class="mt-8 pt-8 border-t border-gray-200">
        <h3 class="text-lg font-medium text-gray-900 mb-4">💡 Pro Tips</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-gray-50 rounded-lg p-4">
            <h4 class="font-medium text-gray-900 mb-2">Set a Budget</h4>
            <p class="text-sm text-gray-600">Only play with money you can afford to lose. Set daily, weekly, or monthly limits.</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-4">
            <h4 class="font-medium text-gray-900 mb-2">Play Consistently</h4>
            <p class="text-sm text-gray-600">Consider subscriptions to never miss a draw with your favorite numbers.</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-4">
            <h4 class="font-medium text-gray-900 mb-2">Understand Odds</h4>
            <p class="text-sm text-gray-600">All numbers have equal chances. Past results don't affect future draws.</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-4">
            <h4 class="font-medium text-gray-900 mb-2">Check Results</h4>
            <p class="text-sm text-gray-600">Always verify your tickets. Small prizes are easy to miss!</p>
          </div>
        </div>
      </div>

      <%= form_with url: onboarding_tutorial_path, method: :post, local: true, class: "mt-8" do |form| %>
        <div class="flex space-x-4">
          <%= link_to "Back", onboarding_identity_verification_path, 
                      class: "flex-1 flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out" %>
          
          <%= form.submit "Get Started!", 
                          class: "flex-1 flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
