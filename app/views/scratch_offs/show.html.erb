<% content_for :title, "#{@instant_game.name} - Scratch Off Ticket" %>

<div class="min-h-screen bg-gradient-to-br from-purple-50 to-pink-100">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to instant_games_path, 
          class: "inline-flex items-center text-purple-600 hover:text-purple-800 font-medium" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Instant Games
      <% end %>
    </div>

    <!-- Game Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @instant_game.name %></h1>
      <p class="text-lg text-gray-600">Ticket #<%= @scratch_off.id %></p>
    </div>

    <!-- Scratch-Off Ticket -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
        
        <!-- Ticket Header -->
        <div class="bg-gradient-to-r from-<%= instant_game_color(@instant_game.ticket_price) %>-500 to-<%= instant_game_color(@instant_game.ticket_price) %>-600 p-6 text-white">
          <div class="flex justify-between items-center">
            <div>
              <h2 class="text-2xl font-bold"><%= @instant_game.name %></h2>
              <p class="text-<%= instant_game_color(@instant_game.ticket_price) %>-100">
                <%= @instant_game.description %>
              </p>
            </div>
            <div class="text-right">
              <div class="text-3xl font-bold">$<%= @instant_game.ticket_price %></div>
              <div class="text-sm text-<%= instant_game_color(@instant_game.ticket_price) %>-100">Ticket Price</div>
            </div>
          </div>
        </div>

        <!-- Scratch Area -->
        <div class="p-8">
          <% if @can_scratch %>
            <!-- Unscratched State -->
            <div id="scratch-container" class="relative">
              <div class="text-center mb-6">
                <h3 class="text-xl font-bold text-gray-900 mb-2">Scratch to Reveal Your Prize!</h3>
                <p class="text-gray-600">Click and drag to scratch off the silver coating</p>
              </div>

              <!-- Scratch Canvas -->
              <div class="relative bg-gray-100 rounded-xl overflow-hidden" style="height: 300px;">
                <!-- Hidden Prize Content -->
                <div id="prize-content" class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-yellow-100 to-yellow-200">
                  <div class="text-center">
                    <div id="prize-symbols" class="grid grid-cols-3 gap-4 mb-6">
                      <!-- Prize symbols will be populated by JavaScript -->
                    </div>
                    <div id="prize-amount" class="text-4xl font-bold text-gray-900 mb-2">
                      <!-- Prize amount will be shown after scratching -->
                    </div>
                    <div id="prize-message" class="text-lg text-gray-600">
                      <!-- Win/lose message will be shown here -->
                    </div>
                  </div>
                </div>

                <!-- Scratch Overlay -->
                <canvas id="scratch-canvas" 
                        width="600" 
                        height="300" 
                        class="absolute inset-0 w-full h-full cursor-pointer"
                        style="background: linear-gradient(45deg, #c0c0c0, #a0a0a0); background-size: 20px 20px;">
                </canvas>
              </div>

              <!-- Scratch Instructions -->
              <div class="mt-6 text-center">
                <button id="scratch-all-btn" 
                        class="bg-<%= instant_game_color(@instant_game.ticket_price) %>-500 hover:bg-<%= instant_game_color(@instant_game.ticket_price) %>-600 text-white px-6 py-3 rounded-lg font-semibold transition-colors">
                  Reveal All
                </button>
              </div>
            </div>

          <% else %>
            <!-- Already Scratched State -->
            <div class="text-center">
              <% if @is_winner %>
                <!-- Winner Display -->
                <div class="bg-gradient-to-br from-green-100 to-green-200 rounded-xl p-8 mb-6">
                  <div class="text-6xl mb-4">🎉</div>
                  <h3 class="text-3xl font-bold text-green-800 mb-2">Congratulations!</h3>
                  <div class="text-5xl font-bold text-green-600 mb-4">
                    $<%= number_with_delimiter(@scratch_off.prize_amount.to_i) %>
                  </div>
                  <p class="text-green-700 text-lg">You're a winner!</p>
                  
                  <!-- Winning Symbols -->
                  <% if @scratch_off.winning_symbols.present? %>
                    <div class="mt-6">
                      <p class="text-green-600 mb-3">Winning Combination:</p>
                      <div class="flex justify-center space-x-3">
                        <% JSON.parse(@scratch_off.winning_symbols).each do |symbol| %>
                          <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center text-2xl shadow-lg">
                            <%= winning_symbol_for_amount(@scratch_off.prize_amount) %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- Claim Prize Button -->
                <% if @scratch_off.status == 'scratched' %>
                  <%= link_to claim_scratch_off_path(@scratch_off), 
                      method: :post,
                      class: "bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors",
                      confirm: "Claim your prize of $#{number_with_delimiter(@scratch_off.prize_amount.to_i)}?" do %>
                    💰 Claim Prize
                  <% end %>
                <% else %>
                  <div class="bg-purple-100 text-purple-800 px-6 py-3 rounded-lg font-semibold">
                    Prize Already Claimed
                  </div>
                <% end %>

              <% else %>
                <!-- No Win Display -->
                <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl p-8 mb-6">
                  <div class="text-6xl mb-4">😔</div>
                  <h3 class="text-2xl font-bold text-gray-700 mb-2">Better Luck Next Time!</h3>
                  <p class="text-gray-600 text-lg">This ticket didn't win, but don't give up!</p>
                  
                  <!-- Non-winning symbols -->
                  <div class="mt-6">
                    <div class="flex justify-center space-x-3">
                      <% 3.times do |i| %>
                        <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center text-2xl shadow-lg">
                          ❌
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Play Again Button -->
                <%= link_to instant_game_path(@instant_game), 
                    class: "bg-<%= instant_game_color(@instant_game.ticket_price) %>-500 hover:bg-<%= instant_game_color(@instant_game.ticket_price) %>-600 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors" do %>
                  🎫 Play Again
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Ticket Footer -->
        <div class="bg-gray-50 px-6 py-4 border-t">
          <div class="flex justify-between items-center text-sm text-gray-600">
            <span>Purchased: <%= @scratch_off.created_at.strftime("%m/%d/%Y at %I:%M %p") %></span>
            <span>Overall Odds: 1 in <%= @instant_game.overall_odds %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Game Actions -->
    <div class="max-w-2xl mx-auto mt-8">
      <div class="flex flex-col sm:flex-row gap-4">
        <%= link_to scratch_offs_path, 
            class: "flex-1 bg-white border-2 border-gray-300 text-gray-700 text-center py-3 rounded-lg font-semibold hover:bg-gray-50 transition-colors" do %>
          View All Tickets
        <% end %>
        <%= link_to instant_games_path, 
            class: "flex-1 bg-purple-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors" do %>
          Play More Games
        <% end %>
      </div>
    </div>

    <!-- Prize Information -->
    <div class="max-w-2xl mx-auto mt-8">
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Prize Information</h3>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-600">Top Prize:</span>
            <span class="font-semibold">$<%= number_with_delimiter(@instant_game.top_prize.to_i) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Overall Odds:</span>
            <span class="font-semibold">1 in <%= @instant_game.overall_odds %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Tickets Remaining:</span>
            <span class="font-semibold <%= remaining_tickets_color(@instant_game) %>">
              <%= number_with_delimiter(@instant_game.tickets_remaining) %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Total Prizes:</span>
            <span class="font-semibold">$<%= number_with_delimiter(@instant_game.total_prize_value.to_i) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Scratch-off JavaScript -->
<% if @can_scratch %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const canvas = document.getElementById('scratch-canvas');
      const ctx = canvas.getContext('2d');
      const prizeContent = document.getElementById('prize-content');
      const scratchAllBtn = document.getElementById('scratch-all-btn');
      
      let isScratching = false;
      let scratchedArea = 0;
      const totalArea = canvas.width * canvas.height;
      
      // Initialize scratch surface
      function initScratchSurface() {
        const gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
        gradient.addColorStop(0, '#c0c0c0');
        gradient.addColorStop(0.5, '#a0a0a0');
        gradient.addColorStop(1, '#808080');
        
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Add scratch pattern
        ctx.fillStyle = '#999999';
        for (let i = 0; i < canvas.width; i += 20) {
          for (let j = 0; j < canvas.height; j += 20) {
            if ((i + j) % 40 === 0) {
              ctx.fillRect(i, j, 10, 10);
            }
          }
        }
      }
      
      // Scratch function
      function scratch(x, y) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.beginPath();
        ctx.arc(x, y, 20, 0, 2 * Math.PI);
        ctx.fill();
        
        // Calculate scratched percentage
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        let transparent = 0;
        for (let i = 3; i < imageData.data.length; i += 4) {
          if (imageData.data[i] === 0) transparent++;
        }
        
        scratchedArea = (transparent / (imageData.data.length / 4)) * 100;
        
        // Reveal prize if enough is scratched
        if (scratchedArea > 30) {
          revealPrize();
        }
      }
      
      // Get mouse/touch position
      function getEventPos(e) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        
        if (e.touches) {
          return {
            x: (e.touches[0].clientX - rect.left) * scaleX,
            y: (e.touches[0].clientY - rect.top) * scaleY
          };
        } else {
          return {
            x: (e.clientX - rect.left) * scaleX,
            y: (e.clientY - rect.top) * scaleY
          };
        }
      }
      
      // Reveal prize
      function revealPrize() {
        fetch('<%= scratch_scratch_off_path(@scratch_off) %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Clear canvas
            canvas.style.display = 'none';
            
            // Show prize content
            const prizeAmount = document.getElementById('prize-amount');
            const prizeMessage = document.getElementById('prize-message');
            const prizeSymbols = document.getElementById('prize-symbols');
            
            if (data.is_winner) {
              prizeAmount.innerHTML = `$${data.prize_amount.toLocaleString()}`;
              prizeMessage.innerHTML = data.message;
              prizeContent.className = 'absolute inset-0 flex items-center justify-center bg-gradient-to-br from-green-100 to-green-200';
              
              // Show winning symbols
              prizeSymbols.innerHTML = '';
              for (let i = 0; i < 3; i++) {
                const symbol = document.createElement('div');
                symbol.className = 'w-16 h-16 bg-white rounded-lg flex items-center justify-center text-2xl shadow-lg animate-bounce';
                symbol.style.animationDelay = `${i * 0.2}s`;
                symbol.innerHTML = '🎉';
                prizeSymbols.appendChild(symbol);
              }
            } else {
              prizeAmount.innerHTML = 'No Win';
              prizeMessage.innerHTML = data.message;
              prizeContent.className = 'absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200';
              
              // Show losing symbols
              prizeSymbols.innerHTML = '';
              for (let i = 0; i < 3; i++) {
                const symbol = document.createElement('div');
                symbol.className = 'w-16 h-16 bg-white rounded-lg flex items-center justify-center text-2xl shadow-lg';
                symbol.innerHTML = '❌';
                prizeSymbols.appendChild(symbol);
              }
            }
            
            // Reload page after 3 seconds to show final state
            setTimeout(() => {
              location.reload();
            }, 3000);
          }
        })
        .catch(error => {
          console.error('Error:', error);
        });
      }
      
      // Event listeners
      canvas.addEventListener('mousedown', (e) => {
        isScratching = true;
        const pos = getEventPos(e);
        scratch(pos.x, pos.y);
      });
      
      canvas.addEventListener('mousemove', (e) => {
        if (isScratching) {
          const pos = getEventPos(e);
          scratch(pos.x, pos.y);
        }
      });
      
      canvas.addEventListener('mouseup', () => {
        isScratching = false;
      });
      
      // Touch events
      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        isScratching = true;
        const pos = getEventPos(e);
        scratch(pos.x, pos.y);
      });
      
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        if (isScratching) {
          const pos = getEventPos(e);
          scratch(pos.x, pos.y);
        }
      });
      
      canvas.addEventListener('touchend', (e) => {
        e.preventDefault();
        isScratching = false;
      });
      
      // Scratch all button
      scratchAllBtn.addEventListener('click', () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        revealPrize();
      });
      
      // Initialize
      initScratchSurface();
    });
  </script>
<% end %>
