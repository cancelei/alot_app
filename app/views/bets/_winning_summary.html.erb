<% if bet.confirmed_on_chain %>
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Winning Summary</h3>
    
    <% if bet.has_winning_numbers? %>
      <div class="bg-green-50 p-4 rounded mb-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-green-800">
              Congratulations! You have <%= pluralize(bet.winning_numbers.count, 'winning number') %>!
            </p>
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="text-sm font-medium text-gray-500">Winning Numbers</h4>
          <div class="flex flex-wrap gap-2 mt-2">
            <% bet.winning_numbers.each do |drawn_number| %>
              <div class="bg-green-100 text-green-800 rounded-full px-3 py-1 text-sm font-medium">
                <%= drawn_number.number %>
              </div>
            <% end %>
          </div>
        </div>
        
        <div>
          <h4 class="text-sm font-medium text-gray-500">Potential Winnings</h4>
          <p class="mt-1 text-2xl font-bold text-green-600"><%= number_to_currency(bet.calculate_winnings) %></p>
        </div>
      </div>
      
      <div class="bg-gray-50 p-4 rounded">
        <p class="text-sm text-gray-600">
          Your winnings will be processed when this lottery cycle completes.
          <% if bet.result == 'pending' %>
            The result is still pending confirmation.
          <% elsif bet.result == 'won' %>
            Your winnings have been confirmed and will be credited to your account.
          <% end %>
        </p>
      </div>
    <% else %>
      <div class="bg-yellow-50 p-4 rounded mb-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-yellow-800">
              No winning numbers in this bet yet.
            </p>
          </div>
        </div>
      </div>
      
      <p class="text-sm text-gray-600">
        Keep drawing numbers to increase your chances of winning!
        <% if remaining_draws(bet) > 0 %>
          You can still draw <%= pluralize(remaining_draws(bet), 'more number') %>.
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
