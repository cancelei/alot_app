<%# Navigation Bar Partial - Conditionally renders based on user role %>
<nav class="bg-white border-b border-gray-200 fixed w-full z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <%# Logo and brand section %>
      <div class="flex">
        <div class="flex-shrink-0 flex items-center">
          <%= link_to root_path, class: "flex items-center" do %>
            <%# Replace with your actual logo %>
            <span class="text-indigo-600 font-bold text-xl">Alot App</span>
          <% end %>
        </div>
        
        <%# Main navigation links - visible on medium screens and up %>
        <div class="hidden md:ml-6 md:flex md:space-x-4 md:items-center">
          <% if user_signed_in? && current_user.super_admin? %>
            <%= link_to "Dashboard", admin_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(admin_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
          <% else %>
            <%= link_to "Dashboard", player_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(player_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
          <% end %>
          
          <%# Player-specific links %>
          <% if user_signed_in? && current_user.player? %>
            <%= link_to "My Bets", player_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(player_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
            <%= link_to "Lotteries", lotteries_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(lotteries_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
            <div class="relative" data-controller="dropdown">
              <button type="button" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none group" 
                      data-action="click->dropdown#toggle" 
                      data-dropdown-target="button">
                Lottery Games
                <svg class="ml-1 -mr-1 h-5 w-5 inline group-hover:text-indigo-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class="hidden absolute left-0 mt-2 w-56 bg-white rounded-md shadow-lg py-1 z-50" 
                   data-dropdown-target="menu">
                <%= link_to "All Lottery Games", lotteries_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Request New Games", feature_requests_lotteries_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <div class="border-t border-gray-100 my-1"></div>
                <%= link_to game_type_lotteries_path(type: 'scratch_card'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-orange-500 mr-2"></span> Scratch Cards
                <% end %>
                <%= link_to game_type_lotteries_path(type: 'powerball'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-red-500 mr-2"></span> Powerball
                <% end %>
                <%= link_to game_type_lotteries_path(type: 'keno'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-blue-500 mr-2"></span> Keno
                <% end %>
                <%= link_to game_type_lotteries_path(type: 'daily_draw'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span> Daily Draw
                <% end %>
              </div>
            </div>
            <%= link_to "Feature Requests", feature_requests_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(feature_requests_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
          <% end %>
          
          <%# Admin-specific links %>
          <% if user_signed_in? && current_user.super_admin? %>
            <div class="relative" data-controller="dropdown">
              <button type="button" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none" 
                      data-action="click->dropdown#toggle" 
                      data-dropdown-target="button">
                Admin
                <svg class="ml-1 -mr-1 h-5 w-5 inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50" 
                   data-dropdown-target="menu">
                <%= link_to "Dashboard", admin_dashboard_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Manage Users", admin_users_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Manage Lotteries", admin_lotteries_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                
                <div class="border-t border-gray-100 my-1"></div>
                <div class="px-4 py-1 text-xs font-semibold text-gray-500">Feature Requests</div>
                
                <%= link_to "All Requests", admin_feature_requests_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to admin_feature_requests_path(category: 'lottery_game'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-indigo-500 mr-2"></span> Lottery Games
                <% end %>
                
                <div class="pl-6">
                  <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'scratch_card'), class: "block px-4 py-1 text-xs text-gray-600 hover:bg-gray-100 flex items-center" do %>
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500 mr-1.5"></span> Scratch Cards
                  <% end %>
                  <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'powerball'), class: "block px-4 py-1 text-xs text-gray-600 hover:bg-gray-100 flex items-center" do %>
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span> Powerball
                  <% end %>
                  <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'keno'), class: "block px-4 py-1 text-xs text-gray-600 hover:bg-gray-100 flex items-center" do %>
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1.5"></span> Keno
                  <% end %>
                  <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'daily_draw'), class: "block px-4 py-1 text-xs text-gray-600 hover:bg-gray-100 flex items-center" do %>
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span> Daily Draw
                  <% end %>
                </div>
                
                <%= link_to admin_feature_requests_path(category: 'user_interface'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-teal-500 mr-2"></span> UI/UX
                <% end %>
                <%= link_to admin_feature_requests_path(category: 'payment'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center" do %>
                  <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span> Payment
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      
      <%# Right side - user account section %>
      <div class="flex items-center">
        <% if user_signed_in? %>
          <%# Notification bell - for future implementation %>
          <button type="button" class="p-2 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100 focus:outline-none">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </button>
          
          <%# User dropdown menu %>
          <div class="ml-3 relative" data-controller="dropdown">
            <div>
              <button type="button" class="flex items-center max-w-xs rounded-full text-sm focus:outline-none"
                      data-action="click->dropdown#toggle"
                      data-dropdown-target="button">
                <span class="sr-only">Open user menu</span>
                <div class="h-8 w-8 rounded-full bg-indigo-600 flex items-center justify-center text-white">
                  <%= current_user.name.first %>
                </div>
              </button>
            </div>
            <div class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg py-1 bg-white ring-1 ring-black ring-opacity-5 z-50" 
                 data-dropdown-target="menu">
              <div class="px-4 py-2 text-sm text-gray-700 border-b">
                <div class="font-medium"><%= current_user.name %></div>
                <div class="text-gray-500 truncate"><%= current_user.email %></div>
              </div>
              <%= link_to "Your Profile", edit_user_registration_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              <% if current_user.wallet_connected? %>
                <%= link_to "Wallet Settings", edit_user_registration_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              <% else %>
                <%= link_to "Connect Wallet", edit_user_registration_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              <% end %>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "ml-3 px-4 py-2 text-sm font-medium text-indigo-600 border border-indigo-600 rounded-md hover:bg-indigo-50" %>
        <% end %>
        
        <%# Mobile menu button %>
        <div class="flex items-center md:hidden ml-4">
          <button type="button" class="p-2 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100 focus:outline-none"
                  data-controller="mobile-menu" 
                  data-action="click->mobile-menu#toggle">
            <span class="sr-only">Open main menu</span>
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-mobile-menu-target="openIcon">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-mobile-menu-target="closeIcon">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <%# Mobile menu, show/hide based on menu state %>
  <div class="hidden md:hidden" data-mobile-menu-target="menu">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <% if user_signed_in? && current_user.super_admin? %>
        <%= link_to "Dashboard", admin_dashboard_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(admin_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
      <% else %>
        <%= link_to "Dashboard", player_dashboard_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(player_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
      <% end %>
      
      <%# Player-specific links - mobile %>
      <% if user_signed_in? && current_user.player? %>
        <%= link_to "My Bets", player_dashboard_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(player_dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
        <%= link_to "Lotteries", lotteries_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(lotteries_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
        <%= link_to "New Lottery Games", feature_requests_lotteries_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(feature_requests_lotteries_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
        <%= link_to "Feature Requests", feature_requests_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(feature_requests_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" %>
      <% end %>
      
      <%# Admin-specific links - mobile %>
      <% if user_signed_in? && current_user.super_admin? %>
        <div class="border-t border-gray-200 mt-2 pt-2">
          <div class="px-3 py-2 text-base font-medium text-gray-900">Admin</div>
          <%= link_to "Manage Lotteries", admin_lotteries_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 pl-6" %>
          <%= link_to "Manage Users", admin_users_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 pl-6" %>
          <%= link_to "Feature Requests", admin_feature_requests_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 pl-6" %>
          <%= link_to "Lottery Game Requests", feature_requests_lotteries_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 pl-6" %>
        </div>
      <% end %>
      
      <%# User account links - mobile %>
      <% if user_signed_in? %>
        <div class="border-t border-gray-200 mt-2 pt-2">
          <div class="px-3 py-2">
            <div class="text-base font-medium text-gray-900"><%= current_user.name %></div>
            <div class="text-sm font-medium text-gray-500"><%= current_user.email %></div>
          </div>
          <%= link_to "Your Profile", edit_user_registration_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
          <% if current_user.wallet_connected? %>
            <%= link_to "Wallet Settings", edit_user_registration_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
          <% else %>
            <%= link_to "Connect Wallet", edit_user_registration_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
          <% end %>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
