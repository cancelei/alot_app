<%# Lottery Result Verification View %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="verification">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6 bg-blue-50">
      <h1 class="text-2xl font-bold text-gray-900">
        Lottery Result Verification
      </h1>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">
        Verify the integrity and transparency of lottery results
      </p>
    </div>
    
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="mb-8">
        <h2 class="text-lg font-medium text-gray-900 mb-2">Lottery Information</h2>
        <div class="bg-gray-50 p-4 rounded-md">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Lottery Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @lottery.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Cycle Number</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @result.cycle_number %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Winning Number</dt>
              <dd class="mt-1 text-sm text-gray-900 font-mono bg-yellow-50 p-1 rounded">
                <%= @result.winning_number %>
                <button type="button" 
                        class="ml-2 text-blue-600 hover:text-blue-800"
                        data-verification-target="copyButton"
                        data-action="click->verification#copyToClipboard"
                        data-copy-text="<%= @result.winning_number %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Result Hash</dt>
              <dd class="mt-1 text-sm text-gray-900 font-mono bg-gray-100 p-1 rounded truncate">
                <%= @result.result_hash %>
                <button type="button" 
                        class="ml-2 text-blue-600 hover:text-blue-800"
                        data-verification-target="copyButton"
                        data-action="click->verification#copyToClipboard"
                        data-copy-text="<%= @result.result_hash %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </dd>
            </div>
          </dl>
        </div>
      </div>
      
      <div class="mb-8">
        <h2 class="text-lg font-medium text-gray-900 mb-2">Verification Steps</h2>
        <div class="bg-gray-50 p-4 rounded-md">
          <div class="space-y-4">
            <% @verification_steps.each_with_index do |step, index| %>
              <div class="verification-step border border-gray-200 rounded-md overflow-hidden" 
                   data-verification-target="step"
                   data-step-index="<%= index %>">
                <div class="bg-white px-4 py-3 flex items-center justify-between cursor-pointer"
                     data-action="click->verification#toggleStep">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-800 font-semibold text-sm">
                      <%= step[:step] %>
                    </div>
                    <h3 class="ml-3 text-sm font-medium text-gray-900"><%= step[:title] %></h3>
                  </div>
                  <div>
                    <svg class="h-5 w-5 text-gray-400 transform transition-transform duration-200" 
                         data-verification-target="stepIcon"
                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 hidden" data-verification-target="stepContent">
                  <p class="text-sm text-gray-600 mb-3"><%= step[:description] %></p>
                  <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
                    <% step[:data].each do |key, value| %>
                      <div class="sm:col-span-1">
                        <dt class="text-xs font-medium text-gray-500"><%= key.to_s.titleize %></dt>
                        <dd class="mt-1 text-sm text-gray-900 break-all">
                          <%= value.is_a?(Time) ? value.strftime("%Y-%m-%d %H:%M:%S UTC") : value.to_s %>
                        </dd>
                      </div>
                    <% end %>
                  </dl>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      
      <div class="mb-8">
        <h2 class="text-lg font-medium text-gray-900 mb-2">Winning Bets</h2>
        <% if @winning_bets.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bet ID</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Player</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Chosen Numbers</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @winning_bets.each do |bet| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= bet.id %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= bet.user.username || bet.user.email.split('@').first %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= number_to_currency(bet.amount) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-mono bg-yellow-50">
                      <%= bet.chosen_numbers %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if bet.paid_out? %>
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                          Paid Out
                        </span>
                      <% else %>
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                          Won (Pending Payout)
                        </span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= link_to "Verify Bet", verification_bet_path(bet), class: "text-blue-600 hover:text-blue-900" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="bg-gray-50 p-4 rounded-md text-center text-gray-500">
            No winning bets found for this lottery cycle
          </div>
        <% end %>
      </div>
      
      <div class="mt-8 text-center">
        <div class="inline-flex rounded-md shadow">
          <a href="<%= @result.blockchain_explorer_url %>" target="_blank" class="inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
            View on Blockchain Explorer
            <svg class="ml-2 -mr-1 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
      
      <div class="mt-4 text-center text-sm text-gray-500">
        <p>This verification page is publicly accessible for transparency.</p>
        <p class="mt-1">
          <a href="<%= lottery_path(@lottery) %>" class="text-blue-600 hover:text-blue-900">
            Back to Lottery
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<%# Notification for copy to clipboard %>
<div class="fixed bottom-4 right-4 transform translate-y-10 opacity-0 transition-all duration-300 ease-in-out"
     data-verification-target="notification">
  <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-md">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm">Copied to clipboard!</p>
      </div>
    </div>
  </div>
</div>
