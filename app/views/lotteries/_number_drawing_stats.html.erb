<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h3 class="text-lg font-medium text-gray-900 mb-4">Number Drawing Statistics</h3>
  
  <% total_drawn_numbers = lottery.drawn_numbers.count %>
  <% if total_drawn_numbers > 0 %>
    <% popular_numbers = lottery.drawn_numbers.group(:number).order('count_id DESC').count(:id).first(5) %>
    <% least_drawn = lottery.drawn_numbers.group(:number).order('count_id ASC').count(:id).first(5) %>
    
    <div class="space-y-6">
      <div>
        <h4 class="text-sm font-medium text-gray-500 mb-2">Most Popular Numbers</h4>
        <div class="flex flex-wrap gap-2">
          <% popular_numbers.each do |number, count| %>
            <div class="bg-blue-100 text-blue-800 rounded-full px-3 py-1 text-sm flex items-center">
              <span class="font-bold mr-1"><%= number %></span>
              <span class="text-xs text-blue-600">(<%= count %> times)</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div>
        <h4 class="text-sm font-medium text-gray-500 mb-2">Least Drawn Numbers</h4>
        <div class="flex flex-wrap gap-2">
          <% least_drawn.each do |number, count| %>
            <div class="bg-gray-100 text-gray-800 rounded-full px-3 py-1 text-sm flex items-center">
              <span class="font-bold mr-1"><%= number %></span>
              <span class="text-xs text-gray-600">(<%= count %> times)</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <h4 class="text-sm font-medium text-gray-500">Total Numbers Drawn</h4>
          <p class="mt-1 text-lg font-semibold text-gray-900"><%= total_drawn_numbers %></p>
        </div>
        
        <div>
          <h4 class="text-sm font-medium text-gray-500">Average Numbers Per Bet</h4>
          <p class="mt-1 text-lg font-semibold text-gray-900">
            <%= (lottery.bets.count > 0 ? (total_drawn_numbers.to_f / lottery.bets.count).round(1) : 0) %>
          </p>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-4 text-gray-500">
      <p>No numbers have been drawn for this lottery yet</p>
    </div>
  <% end %>
</div>
