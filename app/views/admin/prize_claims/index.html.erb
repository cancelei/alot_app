<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Prize Claims Management</h1>
      <p class="text-gray-600 mt-2">Manage lottery prize claims and payouts</p>
    </div>
    
    <div class="flex space-x-4">
      <%= form_with url: admin_prize_claims_path, method: :post, local: true, class: "inline" do |form| %>
        <%= form.hidden_field :bulk_action, value: "process_auto_credits" %>
        <%= form.submit "Process Auto-Credits", class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
      <% end %>
      
      <%= form_with url: admin_prize_claims_path, method: :post, local: true, class: "inline" do |form| %>
        <%= form.hidden_field :bulk_action, value: "expire_old_claims" %>
        <%= form.submit "Expire Old Claims", class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
      <% end %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-blue-100 rounded-lg">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Total Prize Value</p>
          <p class="text-2xl font-semibold text-gray-900">$<%= number_with_delimiter(@stats[:total_prize_amount]) %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-yellow-100 rounded-lg">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Pending Claims</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:pending_claims] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-red-100 rounded-lg">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Expiring Soon</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:expiring_soon] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-green-100 rounded-lg">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Claims Processed</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:claimed_total] + @stats[:auto_credited] %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <%= form_with url: admin_prize_claims_path, method: :get, local: true, class: "flex flex-wrap items-end gap-4" do |form| %>
      <div class="flex-1 min-w-64">
        <%= form.text_field :search, placeholder: "Search by user email or username...", 
                           value: @search_query, 
                           class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
      
      <div>
        <%= form.select :status, 
                       options_for_select([
                         ['All Claims', 'all'],
                         ['Pending', 'pending'],
                         ['Auto-Credited', 'auto_credited'],
                         ['Manual Claim Required', 'manual_claim_required'],
                         ['Claimed', 'claimed'],
                         ['Expired', 'expired'],
                         ['Expiring Soon', 'expiring_soon']
                       ], @filter_status),
                       {},
                       { class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
      </div>
      
      <div>
        <%= form.submit "Filter", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition-colors" %>
      </div>
    <% end %>
  </div>

  <!-- Prize Claims Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Game</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prize Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tax Withholding</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Claim Deadline</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @prize_claims.each do |claim| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div>
                    <div class="text-sm font-medium text-gray-900"><%= claim.user.name %></div>
                    <div class="text-sm text-gray-500"><%= claim.user.email %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= claim.lottery_game.name %></div>
                <div class="text-sm text-gray-500">Draw #<%= claim.draw.id %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">$<%= number_with_delimiter(claim.prize_amount) %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <% if claim.tax_withholding_amount.present? %>
                    $<%= number_with_delimiter(claim.tax_withholding_amount) %>
                  <% else %>
                    <span class="text-gray-400">None</span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% case claim.status %>
                <% when 'pending' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                <% when 'auto_credited' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Auto-Credited</span>
                <% when 'manual_claim_required' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">Manual Required</span>
                <% when 'claimed' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Claimed</span>
                <% when 'expired' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Expired</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= claim.claim_deadline.strftime("%b %d, %Y") %>
                <% if claim.days_until_expiration <= 30 && !claim.claimed? && !claim.expired? %>
                  <div class="text-xs text-red-600">(<%= claim.days_until_expiration %> days left)</div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                <%= link_to "View", admin_prize_claim_path(claim), 
                           class: "text-blue-600 hover:text-blue-900" %>
                
                <% if claim.manual_claim_required? %>
                  <%= link_to "Process", process_claim_admin_prize_claim_path(claim), 
                             method: :patch,
                             data: { confirm: "Process this prize claim for $#{number_with_delimiter(claim.net_prize_amount)}?" },
                             class: "text-green-600 hover:text-green-900" %>
                <% end %>
                
                <% if claim.pending? || claim.manual_claim_required? %>
                  <%= link_to "Expire", expire_claim_admin_prize_claim_path(claim), 
                             method: :patch,
                             data: { confirm: "Are you sure you want to expire this claim?" },
                             class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <% if @prize_claims.empty? %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No prize claims found</h3>
          <p class="mt-1 text-sm text-gray-500">No prize claims match your current filters.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
