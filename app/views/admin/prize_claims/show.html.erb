<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Prize Claim Details</h1>
      <p class="text-gray-600 mt-2">Claim #<%= @prize_claim.id %> - <%= @prize_claim.lottery_game.name %></p>
    </div>
    
    <div class="flex space-x-4">
      <%= link_to "Back to Claims", admin_prize_claims_path, 
                 class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
      
      <% if @prize_claim.manual_claim_required? %>
        <%= link_to "Process Claim", process_claim_admin_prize_claim_path(@prize_claim), 
                   method: :patch,
                   data: { confirm: "Process this prize claim for $#{number_with_delimiter(@prize_claim.net_prize_amount)}?" },
                   class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Prize Claim Information -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Claim Status Card -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Claim Status</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Current Status</label>
            <% case @prize_claim.status %>
            <% when 'pending' %>
              <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending Processing</span>
            <% when 'auto_credited' %>
              <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">Auto-Credited</span>
            <% when 'manual_claim_required' %>
              <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-orange-100 text-orange-800">Manual Claim Required</span>
            <% when 'claimed' %>
              <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">Claimed</span>
            <% when 'expired' %>
              <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">Expired</span>
            <% end %>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Claim Deadline</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.claim_deadline.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% if @prize_claim.days_until_expiration <= 30 && !@prize_claim.claimed? && !@prize_claim.expired? %>
              <p class="text-xs text-red-600 mt-1"><%= @prize_claim.days_until_expiration %> days remaining</p>
            <% end %>
          </div>
        </div>

        <% if @prize_claim.claimed_at.present? %>
          <div class="mt-4 pt-4 border-t border-gray-200">
            <label class="block text-sm font-medium text-gray-700 mb-1">Claimed At</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.claimed_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% if @prize_claim.processed_by.present? %>
              <p class="text-xs text-gray-600 mt-1">Processed by: <%= @prize_claim.processed_by.email %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Prize Information Card -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Prize Information</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Gross Prize Amount</label>
            <p class="text-2xl font-bold text-green-600">$<%= number_with_delimiter(@prize_claim.prize_amount) %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tax Withholding</label>
            <p class="text-lg font-semibold text-red-600">
              <% if @prize_claim.tax_withholding_amount.present? %>
                -$<%= number_with_delimiter(@prize_claim.tax_withholding_amount) %>
              <% else %>
                $0.00
              <% end %>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Net Prize Amount</label>
            <p class="text-2xl font-bold text-blue-600">$<%= number_with_delimiter(@prize_claim.net_prize_amount) %></p>
          </div>
        </div>

        <% if @prize_claim.requires_tax_withholding? %>
          <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
            <div class="flex">
              <svg class="w-5 h-5 text-yellow-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-yellow-800">Tax Withholding Required</h3>
                <p class="text-sm text-yellow-700 mt-1">Federal and state taxes will be withheld from this prize according to IRS regulations.</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Ticket and Draw Information -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Winning Ticket Details</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Ticket Numbers</label>
            <p class="text-lg font-mono bg-gray-100 px-3 py-2 rounded"><%= @prize_claim.ticket.numbers_display %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Winning Numbers</label>
            <p class="text-lg font-mono bg-green-100 px-3 py-2 rounded text-green-800"><%= @prize_claim.draw.winning_numbers_display %></p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Draw Date</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.draw.draw_date.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Ticket Cost</label>
            <p class="text-sm text-gray-900">$<%= number_with_delimiter(@prize_claim.ticket.cost) %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Purchase Date</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.ticket.purchase_date.strftime("%B %d, %Y") %></p>
          </div>
        </div>
      </div>

      <!-- Processing Notes -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Processing Notes</h2>
        
        <% if @prize_claim.processing_notes.present? %>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @prize_claim.processing_notes %></p>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 italic">No processing notes available.</p>
        <% end %>
        
        <div class="mt-4">
          <%= link_to "Edit Notes", edit_admin_prize_claim_path(@prize_claim), 
                     class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- User Information -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">User Information</h3>
        
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700">Name</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.user.name %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.user.email %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Username</label>
            <p class="text-sm text-gray-900"><%= @prize_claim.user.username %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">State</label>
            <p class="text-sm text-gray-900">
              <%= @prize_claim.user.state_jurisdiction&.name || "Not specified" %>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Account Balance</label>
            <p class="text-sm text-gray-900">$<%= number_with_delimiter(@prize_claim.user.account_balance || 0) %></p>
          </div>
        </div>
        
        <div class="mt-4 pt-4 border-t border-gray-200">
          <%= link_to "View User Profile", admin_user_path(@prize_claim.user), 
                     class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
        
        <div class="space-y-3">
          <% if @prize_claim.manual_claim_required? %>
            <%= link_to process_claim_admin_prize_claim_path(@prize_claim), 
                       method: :patch,
                       data: { confirm: "Process this prize claim for $#{number_with_delimiter(@prize_claim.net_prize_amount)}?" },
                       class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors text-center block" do %>
              Process Claim
            <% end %>
          <% end %>
          
          <% if @prize_claim.pending? || @prize_claim.manual_claim_required? %>
            <%= link_to expire_claim_admin_prize_claim_path(@prize_claim), 
                       method: :patch,
                       data: { confirm: "Are you sure you want to expire this claim?" },
                       class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors text-center block" do %>
              Expire Claim
            <% end %>
          <% end %>
          
          <%= link_to edit_admin_prize_claim_path(@prize_claim), 
                     class: "w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors text-center block" do %>
            Edit Details
          <% end %>
        </div>
      </div>

      <!-- Payment History -->
      <% if @claim_history.any? %>
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Payment History</h3>
          
          <div class="space-y-3">
            <% @claim_history.limit(5).each do |payment| %>
              <div class="flex justify-between items-center py-2 border-b border-gray-100 last:border-b-0">
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= payment.payment_type.humanize %></p>
                  <p class="text-xs text-gray-500"><%= payment.created_at.strftime("%b %d, %Y") %></p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-medium text-gray-900">$<%= number_with_delimiter(payment.amount) %></p>
                  <p class="text-xs text-gray-500"><%= payment.status.humanize %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
