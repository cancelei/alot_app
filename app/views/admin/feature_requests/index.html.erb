<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Feature Requests</h1>
    <%= link_to admin_dashboard_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Dashboard
    <% end %>
  </div>
  
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="p-6 border-b border-gray-200">
      <div class="flex flex-wrap items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-800">All Feature Requests</h2>
        
        <div class="flex flex-col space-y-2 sm:space-y-0 sm:flex-row sm:space-x-2">
          <!-- Status filters -->
          <div class="flex flex-wrap gap-2">
          <%= link_to admin_feature_requests_path, class: "px-3 py-1 #{params[:status].blank? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-blue-200" do %>
            All
            <span class="ml-1 bg-blue-200 text-blue-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.count %></span>
          <% end %>
          
          <%= link_to admin_feature_requests_path(status: 'pending_review'), class: "px-3 py-1 #{params[:status] == 'pending_review' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-yellow-200" do %>
            Pending
            <span class="ml-1 bg-yellow-200 text-yellow-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.pending_review.count %></span>
          <% end %>
          
          <%= link_to admin_feature_requests_path(status: 'approved'), class: "px-3 py-1 #{params[:status] == 'approved' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-green-200" do %>
            Approved
            <span class="ml-1 bg-green-200 text-green-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.approved.count %></span>
          <% end %>
          
          <%= link_to admin_feature_requests_path(status: 'rejected'), class: "px-3 py-1 #{params[:status] == 'rejected' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-red-200" do %>
            Rejected
            <span class="ml-1 bg-red-200 text-red-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.rejected.count %></span>
          <% end %>
          
          <%= link_to admin_feature_requests_path(status: 'shipped'), class: "px-3 py-1 #{params[:status] == 'shipped' ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-purple-200" do %>
            Shipped
            <span class="ml-1 bg-purple-200 text-purple-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.shipped.count %></span>
          <% end %>
          </div>
          
          <!-- Category filters -->
          <div class="flex flex-wrap gap-2 mt-2 sm:mt-0">
            <%= link_to admin_feature_requests_path(category: nil, status: params[:status]), class: "px-3 py-1 #{params[:category].blank? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-blue-200" do %>
              All Categories
            <% end %>
            
            <%= link_to admin_feature_requests_path(category: 'lottery_game', status: params[:status]), class: "px-3 py-1 #{params[:category] == 'lottery_game' ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-indigo-200" do %>
              Lottery Games
              <span class="ml-1 bg-indigo-200 text-indigo-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.lottery_games.count %></span>
            <% end %>
            
            <% if params[:category] == 'lottery_game' %>
              <div class="mt-2 flex flex-wrap gap-2">
                <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'scratch_card', status: params[:status]), 
                            class: "px-3 py-1 #{params[:game_type] == 'scratch_card' ? 'bg-orange-100 text-orange-800' : 'bg-gray-50 text-gray-600'} rounded-full text-xs font-medium hover:bg-orange-200 border border-gray-200" do %>
                  Scratch Card
                <% end %>
                
                <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'powerball', status: params[:status]), 
                            class: "px-3 py-1 #{params[:game_type] == 'powerball' ? 'bg-red-100 text-red-800' : 'bg-gray-50 text-gray-600'} rounded-full text-xs font-medium hover:bg-red-200 border border-gray-200" do %>
                  Powerball
                <% end %>
                
                <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'keno', status: params[:status]), 
                            class: "px-3 py-1 #{params[:game_type] == 'keno' ? 'bg-blue-100 text-blue-800' : 'bg-gray-50 text-gray-600'} rounded-full text-xs font-medium hover:bg-blue-200 border border-gray-200" do %>
                  Keno
                <% end %>
                
                <%= link_to admin_feature_requests_path(category: 'lottery_game', game_type: 'daily_draw', status: params[:status]), 
                            class: "px-3 py-1 #{params[:game_type] == 'daily_draw' ? 'bg-green-100 text-green-800' : 'bg-gray-50 text-gray-600'} rounded-full text-xs font-medium hover:bg-green-200 border border-gray-200" do %>
                  Daily Draw
                <% end %>
              </div>
            <% end %>
            
            <%= link_to admin_feature_requests_path(category: 'user_interface', status: params[:status]), class: "px-3 py-1 #{params[:category] == 'user_interface' ? 'bg-teal-100 text-teal-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-teal-200" do %>
              UI/UX
              <span class="ml-1 bg-teal-200 text-teal-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.user_interfaces.count %></span>
            <% end %>
            
            <%= link_to admin_feature_requests_path(category: 'payment', status: params[:status]), class: "px-3 py-1 #{params[:category] == 'payment' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-emerald-200" do %>
              Payment
              <span class="ml-1 bg-emerald-200 text-emerald-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.payments.count %></span>
            <% end %>
            
            <%= link_to admin_feature_requests_path(category: 'general', status: params[:status]), class: "px-3 py-1 #{params[:category] == 'general' ? 'bg-amber-100 text-amber-800' : 'bg-gray-100 text-gray-800'} rounded-full text-sm font-medium hover:bg-amber-200" do %>
              General
              <span class="ml-1 bg-amber-200 text-amber-800 px-2 py-0.5 rounded-full text-xs"><%= FeatureRequest.generals.count %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <% if @feature_requests.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted By</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @feature_requests.each do |feature_request| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#<%= feature_request.id %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= feature_request.title %></div>
                  <div class="text-sm text-gray-500 truncate max-w-xs"><%= feature_request.description.truncate(100) %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case feature_request.category 
                     when 'lottery_game' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-indigo-100 text-indigo-800">Lottery Game</span>
                  <% when 'user_interface' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-teal-100 text-teal-800">UI/UX</span>
                  <% when 'payment' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-emerald-100 text-emerald-800">Payment</span>
                  <% when 'general' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-amber-100 text-amber-800">General</span>
                  <% else %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Other</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900"><%= feature_request.submitted_by&.name || feature_request.submitted_by&.email || 'Anonymous' %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case feature_request.status 
                     when 'pending_review' %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending Review</span>
                  <% when 'approved' %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
                  <% when 'rejected' %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                  <% when 'shipped' %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">Shipped</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= feature_request.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <%= link_to "View", admin_feature_request_path(feature_request), class: "text-blue-600 hover:text-blue-900" %>
                    
                    <% if feature_request.pending_review? %>
                      <%= button_to "Approve", change_status_admin_feature_request_path(feature_request, status: 'approved'), method: :patch, class: "text-green-600 hover:text-green-900 bg-transparent border-0 p-0 cursor-pointer" %>
                      <%= button_to "Reject", change_status_admin_feature_request_path(feature_request, status: 'rejected'), method: :patch, class: "text-red-600 hover:text-red-900 bg-transparent border-0 p-0 cursor-pointer" %>
                    <% elsif feature_request.approved? %>
                      <%= button_to "Ship", change_status_admin_feature_request_path(feature_request, status: 'shipped'), method: :patch, class: "text-purple-600 hover:text-purple-900 bg-transparent border-0 p-0 cursor-pointer" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No feature requests found</h3>
        <p class="mt-1 text-sm text-gray-500">No feature requests match the current filter.</p>
      </div>
    <% end %>
  </div>
</div>
