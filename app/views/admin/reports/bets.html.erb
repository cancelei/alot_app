<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Betting Reports</h1>
    
    <div class="flex space-x-2">
      <%= link_to admin_reports_players_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Players
      <% end %>
      
      <%= link_to admin_reports_bets_path, class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 8h6m-5 0a3 3 0 110 6H9l3 3m-3-6h6m6 1a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Bets
      <% end %>
      
      <%= link_to admin_reports_payouts_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Payouts
      <% end %>
    </div>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Betting Overview</h3>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-blue-50 p-4 rounded-lg">
          <h4 class="text-sm font-medium text-blue-800 mb-2">Total Bets</h4>
          <p class="text-2xl font-bold text-blue-900"><%= @total_bets %></p>
        </div>
        <div class="bg-green-50 p-4 rounded-lg">
          <h4 class="text-sm font-medium text-green-800 mb-2">Confirmed Bets</h4>
          <p class="text-2xl font-bold text-green-900"><%= @confirmed_bets %></p>
        </div>
        <div class="bg-purple-50 p-4 rounded-lg">
          <h4 class="text-sm font-medium text-purple-800 mb-2">Win Rate</h4>
          <p class="text-2xl font-bold text-purple-900"><%= number_to_percentage(@win_rate, precision: 1) %></p>
        </div>
        <div class="bg-yellow-50 p-4 rounded-lg">
          <h4 class="text-sm font-medium text-yellow-800 mb-2">Avg Bet Amount</h4>
          <p class="text-2xl font-bold text-yellow-900"><%= number_to_currency(@avg_bet_amount) %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Bet Distribution by Status</h3>
      <div class="relative" style="height: 300px;">
        <canvas id="bet-distribution-chart"></canvas>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const ctx = document.getElementById('bet-distribution-chart').getContext('2d');
          
          new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: ['Pending', 'Won', 'Lost'],
              datasets: [{
                data: [<%= @pending_bets_count %>, <%= @won_bets_count %>, <%= @lost_bets_count %>],
                backgroundColor: [
                  'rgba(96, 165, 250, 0.8)',  // Blue
                  'rgba(74, 222, 128, 0.8)',  // Green
                  'rgba(248, 113, 113, 0.8)'  // Red
                ],
                borderColor: [
                  'rgba(96, 165, 250, 1)',
                  'rgba(74, 222, 128, 1)',
                  'rgba(248, 113, 113, 1)'
                ],
                borderWidth: 1
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'right',
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      const label = context.label || '';
                      const value = context.raw;
                      const total = context.dataset.data.reduce((a, b) => a + b, 0);
                      const percentage = Math.round((value / total) * 100);
                      return `${label}: ${value} (${percentage}%)`;
                    }
                  }
                }
              }
            }
          });
        });
      </script>
    </div>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Bets</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Player</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Lottery</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @recent_bets.any? %>
              <% @recent_bets.each do |bet| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#<%= bet.id %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= bet.user&.name || bet.user&.email || 'Anonymous' %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900"><%= bet.lottery.name %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 font-medium"><%= number_to_currency(bet.amount) %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% case bet.result 
                       when 'pending' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Pending</span>
                    <% when 'won' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Won</span>
                    <% when 'lost' %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Lost</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= bet.created_at.strftime("%b %d, %Y %H:%M") %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">No bet data available</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Betting Trends</h3>
      <div class="relative" style="height: 300px;">
        <canvas id="betting-trends-chart"></canvas>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const ctx = document.getElementById('betting-trends-chart').getContext('2d');
          
          // Sample data - in a real app, this would come from the backend
          const days = Array.from({length: 7}, (_, i) => {
            const d = new Date();
            d.setDate(d.getDate() - (6 - i));
            return d.toLocaleDateString('en-US', { weekday: 'short' });
          });
          
          new Chart(ctx, {
            type: 'bar',
            data: {
              labels: days,
              datasets: [{
                label: 'Bet Count',
                data: [<%= rand(10..50) %>, <%= rand(10..50) %>, <%= rand(10..50) %>, <%= rand(10..50) %>, <%= rand(10..50) %>, <%= rand(10..50) %>, <%= @daily_bet_count %>],
                backgroundColor: 'rgba(79, 70, 229, 0.6)',
                borderColor: 'rgba(79, 70, 229, 1)',
                borderWidth: 1
              }, {
                label: 'Bet Volume ($)',
                data: [<%= rand(1000..5000) %>, <%= rand(1000..5000) %>, <%= rand(1000..5000) %>, <%= rand(1000..5000) %>, <%= rand(1000..5000) %>, <%= rand(1000..5000) %>, <%= @daily_bet_volume %>],
                backgroundColor: 'rgba(236, 72, 153, 0.6)',
                borderColor: 'rgba(236, 72, 153, 1)',
                borderWidth: 1,
                yAxisID: 'y1'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  position: 'left',
                  title: {
                    display: true,
                    text: 'Bet Count'
                  }
                },
                y1: {
                  beginAtZero: true,
                  position: 'right',
                  grid: {
                    drawOnChartArea: false
                  },
                  title: {
                    display: true,
                    text: 'Volume ($)'
                  }
                },
                x: {
                  title: {
                    display: true,
                    text: 'Day'
                  }
                }
              },
              plugins: {
                legend: {
                  position: 'top',
                },
                title: {
                  display: false
                }
              }
            }
          });
        });
      </script>
    </div>
  </div>
</div>
