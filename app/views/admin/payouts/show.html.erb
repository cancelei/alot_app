<%# Admin payout details view %>
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Payout Details</h1>
    
    <div class="flex space-x-3">
      <%= link_to admin_payouts_path, class: "px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to All Payouts
      <% end %>
    </div>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Payout Information %>
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
        <div class="p-6 bg-gray-50 border-b">
          <h2 class="text-lg font-semibold text-gray-800">Payout Information</h2>
        </div>
        
        <div class="p-6">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6">
            <div>
              <dt class="text-sm font-medium text-gray-500">Payout ID</dt>
              <dd class="mt-1 text-lg font-semibold text-gray-900">#<%= @payout.id %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1">
                <% case @payout.status %>
                <% when 'completed' %>
                  <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Completed
                  </span>
                <% when 'failed' %>
                  <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Failed
                  </span>
                <% when 'pending' %>
                  <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    Pending
                  </span>
                <% end %>
              </dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Amount</dt>
              <dd class="mt-1 text-lg font-semibold text-green-600"><%= number_to_currency(@payout.amount) %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Processed At</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @payout.created_at.strftime("%B %d, %Y at %H:%M:%S") %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Transaction Hash</dt>
              <dd class="mt-1 text-sm text-gray-900 break-all">
                <div class="flex items-center">
                  <code class="bg-gray-100 p-1 rounded"><%= @payout.transaction_hash %></code>
                  <button 
                    class="ml-2 text-blue-600 hover:text-blue-800"
                    onclick="navigator.clipboard.writeText('<%= @payout.transaction_hash %>'); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 2000);"
                  >
                    Copy
                  </button>
                </div>
              </dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Blockchain Explorer</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to "View on Explorer", "#", class: "text-blue-600 hover:text-blue-800", target: "_blank" %>
                <p class="text-xs text-gray-500 mt-1">(Simulated in MVP - will link to actual blockchain explorer in Phase 2)</p>
              </dd>
            </div>
          </dl>
        </div>
      </div>
      
      <%# Verification Information %>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
        <div class="p-6 bg-gray-50 border-b">
          <h2 class="text-lg font-semibold text-gray-800">Verification Information</h2>
        </div>
        
        <div class="p-6">
          <div class="mb-4">
            <h3 class="text-md font-medium text-gray-700 mb-2">Verification Steps</h3>
            <ol class="list-decimal pl-5 space-y-2">
              <li>Bet was placed on lottery "<%= @payout.lottery.name %>" with <%= number_to_currency(@bet.amount) %></li>
              <li>Bet was recorded on blockchain with transaction hash <%= @bet.transaction_hash %></li>
              <li>Lottery result was calculated using verifiable random function</li>
              <li>Bet was determined to be a winning bet</li>
              <li>Payout of <%= number_to_currency(@payout.amount) %> was processed</li>
              <li>Payout transaction was recorded on blockchain with hash <%= @payout.transaction_hash %></li>
            </ol>
          </div>
          
          <div class="mt-6">
            <%= link_to verify_bet_path(@bet), class: "text-blue-600 hover:text-blue-800 flex items-center", target: "_blank" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
              View Public Verification Page
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <%# Sidebar with related information %>
    <div>
      <%# User Information %>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
        <div class="p-6 bg-gray-50 border-b">
          <h2 class="text-lg font-semibold text-gray-800">User Information</h2>
        </div>
        
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div class="h-12 w-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-500">
              <%= @payout.user.name.first.upcase %>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900"><%= @payout.user.name %></h3>
              <p class="text-sm text-gray-500"><%= @payout.user.email %></p>
            </div>
          </div>
          
          <dl class="grid grid-cols-1 gap-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">User ID</dt>
              <dd class="mt-1 text-sm text-gray-900">#<%= @payout.user.id %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Total Bets</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @payout.user.bets.count %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Total Winnings</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= number_to_currency(PayoutLog.where(user_id: @payout.user.id).sum(:amount)) %>
              </dd>
            </div>
          </dl>
          
          <div class="mt-6">
            <%= link_to admin_reports_player_path(@payout.user), class: "text-blue-600 hover:text-blue-800" do %>
              View User Profile
            <% end %>
          </div>
        </div>
      </div>
      
      <%# Bet Information %>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
        <div class="p-6 bg-gray-50 border-b">
          <h2 class="text-lg font-semibold text-gray-800">Bet Information</h2>
        </div>
        
        <div class="p-6">
          <dl class="grid grid-cols-1 gap-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Bet ID</dt>
              <dd class="mt-1 text-sm text-gray-900">#<%= @bet.id %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Bet Amount</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= number_to_currency(@bet.amount) %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Bet Placed At</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @bet.created_at.strftime("%B %d, %Y at %H:%M:%S") %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Bet Result</dt>
              <dd class="mt-1">
                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  Won
                </span>
              </dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Lottery</dt>
              <dd class="mt-1 text-sm text-blue-600">
                <%= link_to @bet.lottery.name, admin_lottery_path(@bet.lottery) %>
              </dd>
            </div>
          </dl>
          
          <div class="mt-6">
            <%= link_to bet_path(@bet), class: "text-blue-600 hover:text-blue-800" do %>
              View Bet Details
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
