<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Edit Lottery: <%= @lottery.name %></h1>
    <%= link_to admin_lottery_path(@lottery), class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Lottery Details
    <% end %>
  </div>
  
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with(model: [:admin, @lottery], class: "space-y-6") do |form| %>
      <% if @lottery.errors.any? %>
        <div class="bg-red-50 text-red-800 p-4 rounded mb-6">
          <h2 class="text-lg font-medium mb-2">Error: <%= pluralize(@lottery.errors.count, "error") %> prohibited this lottery from being saved</h2>
          <ul class="list-disc pl-5">
            <% @lottery.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <div class="mb-6">
            <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :name, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
          
          <div class="mb-6">
            <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, rows: 4, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
          
          <div class="mb-6">
            <%= form.label :cycles_count, "Number of Cycles", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :cycles_count, min: 1, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
          
          <div class="mb-6">
            <%= form.label :current_payout, "Current Payout Amount ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :current_payout, min: 0, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
        </div>
        
        <div>
          <div class="mb-6">
            <%= form.label :reinvestment_ratio, "Reinvestment Ratio", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :reinvestment_ratio, min: 0, max: 1, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">Enter as decimal (0-1). Example: 0.5 for 50% reinvestment.</p>
          </div>
          
          <div class="mb-6">
            <%= form.label :payout_strategy, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :payout_strategy, Lottery.payout_strategies.keys.map { |s| [s.humanize, s] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
          
          <div class="mb-6">
            <%= form.label :visibility, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :visibility, Lottery.visibilities.keys.map { |v| [v.humanize, v] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
          </div>
          
          <div class="mb-6 flex items-center">
            <%= form.check_box :is_endless, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <%= form.label :is_endless, "Endless Lottery", class: "ml-2 block text-sm text-gray-900" %>
          </div>
        </div>
      </div>
      
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Number Drawing Configuration</h3>
        <div class="bg-gray-50 p-4 rounded mb-4">
          <p class="text-sm text-gray-600">Configure how many numbers users can draw and the cost per number.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div>
            <%= form.label :max_numbers_to_draw, "Maximum Numbers to Draw", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :max_numbers_to_draw, min: 1, max: 10, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">Maximum number of draws a user can make (1-10 recommended).</p>
          </div>
          
          <div>
            <%= form.label :cost_per_number, "Cost Per Number ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :cost_per_number, min: 0.01, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">Amount charged per number drawn.</p>
          </div>
        </div>
      </div>
      
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Lottery Odds</h3>
        <div class="bg-gray-50 p-4 rounded mb-4">
          <p class="text-sm text-gray-600">Configure the odds for this lottery. The total probability should add up to 100%.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <%= form.label "odds_json[win_probability]", "Win Probability (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field "odds_json[win_probability]", value: (@lottery.odds_json["win_probability"].to_f * 100).round(2), min: 0, max: 99, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">Enter as percentage (0-99%). Example: 10 for 10% chance of winning.</p>
          </div>
          
          <div>
            <%= form.label "odds_json[payout_multiplier]", "Payout Multiplier", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field "odds_json[payout_multiplier]", value: @lottery.odds_json["payout_multiplier"], min: 1, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">How much winners receive. Example: 2 means double the bet amount.</p>
          </div>
          
          <div>
            <%= form.label "odds_json[min_bet]", "Minimum Bet ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field "odds_json[min_bet]", value: @lottery.odds_json["min_bet"], min: 0.01, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
            <p class="mt-1 text-xs text-gray-500">Minimum amount required to place a bet.</p>
          </div>
        </div>
      </div>
      
      <div class="border-t border-gray-200 pt-6 flex justify-end">
        <%= form.submit "Update Lottery", class: "px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
