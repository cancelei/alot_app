<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Manage Lotteries</h1>
    <%= link_to new_admin_lottery_path, class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Create New Lottery
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <!-- Status filter tabs -->
    <div class="flex border-b border-gray-200">
      <%= link_to admin_lotteries_path, class: "px-6 py-3 #{params[:status].blank? ? 'bg-blue-50 border-b-2 border-blue-500 text-blue-600' : 'text-gray-500 hover:text-gray-700'}" do %>
        All
        <span class="ml-1 bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full text-xs"><%= @lotteries&.count || 0 %></span>
      <% end %>
      
      <%= link_to admin_lotteries_path(status: 'draft'), class: "px-6 py-3 #{params[:status] == 'draft' ? 'bg-blue-50 border-b-2 border-blue-500 text-blue-600' : 'text-gray-500 hover:text-gray-700'}" do %>
        Draft
        <span class="ml-1 bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full text-xs"><%= @lotteries&.select { |l| l.draft? }&.count || 0 %></span>
      <% end %>
      
      <%= link_to admin_lotteries_path(status: 'active'), class: "px-6 py-3 #{params[:status] == 'active' ? 'bg-blue-50 border-b-2 border-blue-500 text-blue-600' : 'text-gray-500 hover:text-gray-700'}" do %>
        Active
        <span class="ml-1 bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full text-xs"><%= @lotteries&.select { |l| l.active? }&.count || 0 %></span>
      <% end %>
      
      <%= link_to admin_lotteries_path(status: 'ended'), class: "px-6 py-3 #{params[:status] == 'ended' ? 'bg-blue-50 border-b-2 border-blue-500 text-blue-600' : 'text-gray-500 hover:text-gray-700'}" do %>
        Ended
        <span class="ml-1 bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full text-xs"><%= @lotteries&.select { |l| l.ended? }&.count || 0 %></span>
      <% end %>
    </div>
    
    <!-- Lotteries table -->
    <div class="overflow-x-auto">
      <% if @lotteries.present? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Visibility</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Current Payout</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @lotteries.each do |lottery| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#<%= lottery.id %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= lottery.name %></div>
                  <div class="text-sm text-gray-500 truncate max-w-xs"><%= lottery.description.truncate(50) %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case lottery.status %>
                  <% when "draft" %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Draft</span>
                  <% when "active" %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                  <% when "ended" %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Ended</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= lottery.visibility.humanize %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= number_to_currency(lottery.current_payout) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= lottery.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex justify-end space-x-2">
                    <%= link_to admin_lottery_path(lottery), class: "text-blue-600 hover:text-blue-900" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                    <% end %>
                    
                    <%= link_to edit_admin_lottery_path(lottery), class: "text-indigo-600 hover:text-indigo-900" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    <% end %>
                    
                    <% if lottery.draft? %>
                      <%= button_to publish_admin_lottery_path(lottery), method: :post, class: "text-green-600 hover:text-green-900", title: "Publish" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <% if lottery.active? %>
                      <%= button_to deploy_contract_admin_lottery_path(lottery), method: :post, class: "text-purple-600 hover:text-purple-900", title: "Deploy Contract" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <%= button_to admin_lottery_path(lottery), method: :delete, data: { confirm: "Are you sure you want to delete this lottery?" }, class: "text-red-600 hover:text-red-900" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No lotteries found</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by creating a new lottery.</p>
          <div class="mt-6">
            <%= link_to new_admin_lottery_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
              <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Create New Lottery
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
