<%# Admin Dashboard Index View %>
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Admin Dashboard</h1>
    
    <div class="flex items-center space-x-4">
      <div id="last-updated" class="text-sm text-gray-500">
        Last updated: <%= Time.current.strftime("%B %d, %Y %H:%M:%S") %>
      </div>
      
      <button 
        data-controller="admin-dashboard"
        data-action="click->admin-dashboard#refreshDashboard"
        data-admin-dashboard-refresh-url-value="<%= @refresh_url %>"
        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 flex items-center"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Refresh
      </button>
    </div>
  </div>
  
  <%# Dashboard Statistics %>
  <%= render partial: "admin/dashboard/stats", locals: { 
    platform_stats: @platform_stats,
    total_lotteries: @total_lotteries,
    active_lotteries: @active_lotteries,
    draft_lotteries: @draft_lotteries,
    ended_lotteries: @ended_lotteries,
    total_bets: @total_bets,
    total_bet_amount: @total_bet_amount,
    pending_bets: @pending_bets,
    won_bets: @won_bets,
    lost_bets: @lost_bets
  } %>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# Lottery Game Statistics - New Section %>
    <div class="lg:col-span-2">
      <%= render partial: "admin/dashboard/lottery_game_statistics" %>
    </div>
    
    <%# Lottery Game Feature Requests - New Section %>
    <div class="lg:col-span-2">
      <%= render partial: "admin/feature_requests/lottery_game_requests", locals: {
        lottery_game_requests: @lottery_game_requests
      } %>
    </div>
    
    <%# Betting Trends %>
    <div class="lg:col-span-2">
      <%= render partial: "admin/dashboard/betting_trends", locals: {
        betting_trends: @betting_trends
      } %>
    </div>
    
    <%# Recent Activity %>
    <div>
      <%= render partial: "admin/dashboard/recent_activity", locals: {
        recent_bets: @recent_bets,
        recent_payouts: @recent_payouts,
        recent_players: @recent_players
      } %>
    </div>
    
    <%# Feature Requests %>
    <div>
      <%= render partial: "admin/dashboard/feature_requests", locals: {
        total_feature_requests: @total_feature_requests,
        pending_feature_requests: @pending_feature_requests,
        approved_feature_requests: @approved_feature_requests,
        rejected_feature_requests: @rejected_feature_requests,
        shipped_feature_requests: @shipped_feature_requests,
        recent_feature_requests: @recent_feature_requests
      } %>
    </div>
  </div>
  
  <%# Lottery Performance %>
  <div>
    <%= render partial: "admin/dashboard/lottery_performance", locals: {
      top_performing_lotteries: @top_performing_lotteries
    } %>
  </div>
  
  <%# Quick Actions %>
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <%= link_to new_admin_lottery_path, class: "flex items-center p-4 bg-blue-50 rounded-lg hover:bg-blue-100" do %>
        <div class="p-3 bg-blue-100 rounded-full mr-4">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-md font-medium text-blue-800">Create New Lottery</h4>
          <p class="text-sm text-gray-600">Set up a new lottery with custom parameters</p>
        </div>
      <% end %>
      
      <%= link_to admin_reports_players_path, class: "flex items-center p-4 bg-green-50 rounded-lg hover:bg-green-100" do %>
        <div class="p-3 bg-green-100 rounded-full mr-4">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-md font-medium text-green-800">View Reports</h4>
          <p class="text-sm text-gray-600">Access detailed platform analytics</p>
        </div>
      <% end %>
      
      <%= link_to admin_feature_requests_path, class: "flex items-center p-4 bg-purple-50 rounded-lg hover:bg-purple-100" do %>
        <div class="p-3 bg-purple-100 rounded-full mr-4">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-md font-medium text-purple-800">Manage Feature Requests</h4>
          <p class="text-sm text-gray-600">Review and respond to user suggestions</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Include Chart.js for betting trends chart %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
