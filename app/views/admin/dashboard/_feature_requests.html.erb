<%# Admin dashboard feature requests partial %>
<div id="feature-requests" class="bg-white rounded-lg shadow p-6 mb-6">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Feature Request Overview</h3>
  
  <div class="grid grid-cols-5 gap-4 mb-6">
    <div class="bg-gray-50 p-3 rounded-lg text-center">
      <div class="text-xl font-bold text-gray-800"><%= total_feature_requests %></div>
      <div class="text-xs text-gray-500 mt-1">Total</div>
    </div>
    <div class="bg-yellow-50 p-3 rounded-lg text-center">
      <div class="text-xl font-bold text-yellow-800"><%= pending_feature_requests %></div>
      <div class="text-xs text-gray-500 mt-1">Pending</div>
    </div>
    <div class="bg-blue-50 p-3 rounded-lg text-center">
      <div class="text-xl font-bold text-blue-800"><%= approved_feature_requests %></div>
      <div class="text-xs text-gray-500 mt-1">Approved</div>
    </div>
    <div class="bg-red-50 p-3 rounded-lg text-center">
      <div class="text-xl font-bold text-red-800"><%= rejected_feature_requests %></div>
      <div class="text-xs text-gray-500 mt-1">Rejected</div>
    </div>
    <div class="bg-green-50 p-3 rounded-lg text-center">
      <div class="text-xl font-bold text-green-800"><%= shipped_feature_requests %></div>
      <div class="text-xs text-gray-500 mt-1">Shipped</div>
    </div>
  </div>
  
  <h4 class="text-md font-semibold text-gray-700 mb-3">Recent Feature Requests</h4>
  
  <% if recent_feature_requests.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted By</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% recent_feature_requests.each do |feature_request| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= link_to feature_request.title, admin_feature_request_path(feature_request), class: "text-blue-600 hover:text-blue-900" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= feature_request.submitted_by.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= render_feature_request_status_badge(feature_request) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= feature_request.category&.humanize || 'General' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= time_ago_in_words(feature_request.created_at) %> ago
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View", admin_feature_request_path(feature_request), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                <%= render_admin_feature_request_actions(feature_request) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <div class="mt-4 text-right">
      <%= link_to "View All Feature Requests", admin_feature_requests_path, class: "text-sm text-blue-600 hover:text-blue-900" %>
    </div>
  <% else %>
    <div class="py-4 text-center text-gray-500">No feature requests found</div>
  <% end %>
</div>
