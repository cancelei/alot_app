<%# Keno Game Type Detailed View %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Keno Lottery</h1>
    <%= link_to feature_requests_lotteries_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Lottery Games
    <% end %>
  </div>

  <div class="bg-gradient-to-r from-blue-500 to-teal-500 rounded-lg shadow-lg overflow-hidden mb-8">
    <div class="p-8">
      <div class="flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 mb-6 md:mb-0 md:pr-8">
          <h2 class="text-3xl font-bold text-white mb-4">Fast-Paced Number Selection Game</h2>
          <p class="text-blue-100 text-lg mb-6">Keno offers frequent draws and flexible gameplay. Pick your numbers, choose how many spots to play, and watch the draws happen in real-time!</p>
          <div class="bg-white bg-opacity-20 rounded-lg p-4 mb-6">
            <h3 class="text-xl font-semibold text-white mb-2">How It Works</h3>
            <ul class="text-blue-100 space-y-2">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Choose how many numbers (spots) to play (1-10)
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Select your numbers from 1-80 on the Keno board
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                20 numbers are drawn randomly
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Win based on how many of your numbers match
              </li>
            </ul>
          </div>
        </div>
        <div class="md:w-1/2">
          <div class="bg-white rounded-lg shadow-xl p-6">
            <div class="text-center mb-4">
              <h3 class="text-xl font-bold text-gray-800">Keno Board</h3>
            </div>
            <div class="grid grid-cols-8 gap-2">
              <% 80.times do |i| %>
                <div class="<%= [8, 15, 22, 37, 44, 51, 63, 70].include?(i) ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-800' %> rounded h-8 w-8 flex items-center justify-center">
                  <span class="text-sm font-bold"><%= i + 1 %></span>
                </div>
              <% end %>
            </div>
            <div class="mt-4 text-center">
              <div class="inline-flex rounded-md shadow">
                <span class="px-4 py-2 bg-blue-500 text-white text-sm font-medium rounded-l-md">
                  Quick Pick
                </span>
                <span class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-r-md">
                  Clear All
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Game Features</h3>
      <ul class="space-y-3">
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Frequent draws every few minutes</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Flexible betting options from $1 to $20 per draw</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Choose from 1 to 10 spots to play</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Multi-draw options for consecutive games</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Live draw animations with real-time results</span>
        </li>
      </ul>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Prize Structure (4-Spot Game)</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Matches</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prize (per $1)</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Odds</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">4 of 4</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$100</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 326</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 of 4</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$5</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 23</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">2 of 4</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$1</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 5</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-4">
        <p class="text-sm text-gray-600">Note: Prize structures vary based on how many spots you choose to play. More spots offer higher potential payouts but lower odds of winning the top prize.</p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <h3 class="text-xl font-bold text-gray-800 mb-4">Request This Game</h3>
    <p class="text-gray-600 mb-6">Would you like to see Keno added to our platform? Submit your request below and let us know what features you'd like to see!</p>
    
    <%= render partial: "feature_requests/form", locals: { feature_request: @feature_request } %>
  </div>
</div>
