<%# Scratch Card Game Type Detailed View %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Scratch Card Lottery</h1>
    <%= link_to feature_requests_lotteries_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Lottery Games
    <% end %>
  </div>

  <div class="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-lg shadow-lg overflow-hidden mb-8">
    <div class="p-8">
      <div class="flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 mb-6 md:mb-0 md:pr-8">
          <h2 class="text-3xl font-bold text-white mb-4">Instant Win Scratch Cards</h2>
          <p class="text-indigo-100 text-lg mb-6">Reveal hidden symbols and win instantly! Our digital scratch cards offer exciting prizes with immediate results.</p>
          <div class="bg-white bg-opacity-20 rounded-lg p-4 mb-6">
            <h3 class="text-xl font-semibold text-white mb-2">How It Works</h3>
            <ul class="text-indigo-100 space-y-2">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-indigo-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Purchase a digital scratch card
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-indigo-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Scratch to reveal symbols using your mouse or finger
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-indigo-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Match symbols to win prizes instantly
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-indigo-200 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Winnings are credited to your account immediately
              </li>
            </ul>
          </div>
        </div>
        <div class="md:w-1/2">
          <div class="relative">
            <div class="bg-white rounded-lg shadow-xl p-6 transform rotate-3 absolute -right-4 -top-4 z-10">
              <div class="grid grid-cols-3 gap-2">
                <% 9.times do |i| %>
                  <div class="bg-yellow-100 h-16 rounded flex items-center justify-center">
                    <span class="text-2xl font-bold text-yellow-600">?</span>
                  </div>
                <% end %>
              </div>
              <div class="mt-4 text-center">
                <span class="text-sm font-medium text-gray-500">SCRATCH TO REVEAL</span>
              </div>
            </div>
            <div class="bg-white rounded-lg shadow-xl p-6 transform -rotate-2">
              <div class="grid grid-cols-3 gap-2">
                <% symbols = ["$", "★", "♦", "♠", "♥", "♣", "7", "€", "♦"] %>
                <% symbols.each do |symbol| %>
                  <div class="bg-yellow-100 h-16 rounded flex items-center justify-center">
                    <span class="text-2xl font-bold text-yellow-600"><%= symbol %></span>
                  </div>
                <% end %>
              </div>
              <div class="mt-4 text-center">
                <span class="text-sm font-medium text-gray-500">MATCH 3 TO WIN!</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Game Features</h3>
      <ul class="space-y-3">
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Multiple card themes and designs</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Various price points from $1 to $20</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Realistic scratching animation and sound effects</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Special bonus games within each card</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Seasonal and limited edition cards</span>
        </li>
      </ul>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Prize Structure</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Match Type</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prize</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Odds</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 × 7's</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$10,000</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 250,000</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 × $'s</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$1,000</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 25,000</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 × ★'s</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$100</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 2,500</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 × ♦'s</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$50</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 1,000</td>
            </tr>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">3 × Any Symbol</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm font-medium text-green-600">$5</td>
              <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-700">1 in 100</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <h3 class="text-xl font-bold text-gray-800 mb-4">Request This Game</h3>
    <p class="text-gray-600 mb-6">Would you like to see Scratch Card games added to our platform? Submit your request below and let us know what features you'd like to see!</p>
    
    <%= render partial: "feature_requests/form", locals: { feature_request: @feature_request } %>
  </div>
</div>
