<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">My Prize Claims</h1>
      <p class="text-gray-600 mt-2">View and manage your lottery winnings</p>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-green-100 rounded-lg">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Total Winnings</p>
          <p class="text-2xl font-semibold text-gray-900">$<%= number_with_delimiter(@stats[:total_winnings]) %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-blue-100 rounded-lg">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Claims Processed</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:total_claimed] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-yellow-100 rounded-lg">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Pending Claims</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:pending_claims] + @stats[:manual_required] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-2 bg-red-100 rounded-lg">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Expiring Soon</p>
          <p class="text-2xl font-semibold text-gray-900"><%= @stats[:expiring_soon] %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8 px-6">
        <%= link_to prize_claims_path, 
                   class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if params[:status].blank?} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless params[:status].blank?}" do %>
          All Claims
          <span class="ml-2 bg-gray-100 text-gray-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @prize_claims.count %></span>
        <% end %>
        
        <%= link_to prize_claims_path(status: 'pending'), 
                   class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if params[:status] == 'pending'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless params[:status] == 'pending'}" do %>
          Pending
          <span class="ml-2 bg-yellow-100 text-yellow-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @stats[:pending_claims] %></span>
        <% end %>
        
        <%= link_to prize_claims_path(status: 'manual_claim_required'), 
                   class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if params[:status] == 'manual_claim_required'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless params[:status] == 'manual_claim_required'}" do %>
          Manual Required
          <span class="ml-2 bg-orange-100 text-orange-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @stats[:manual_required] %></span>
        <% end %>
        
        <%= link_to prize_claims_path(status: 'auto_credited'), 
                   class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if params[:status] == 'auto_credited'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless params[:status] == 'auto_credited'}" do %>
          Auto-Credited
          <span class="ml-2 bg-green-100 text-green-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @stats[:auto_credited] %></span>
        <% end %>
      </nav>
    </div>
  </div>

  <!-- Prize Claims List -->
  <div class="space-y-6">
    <% if @prize_claims.any? %>
      <% @prize_claims.each do |claim| %>
        <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow">
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                    </svg>
                  </div>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900"><%= claim.lottery_game.name %></h3>
                  <p class="text-sm text-gray-600">Draw #<%= claim.draw.id %> • <%= claim.draw.draw_date.strftime("%B %d, %Y") %></p>
                </div>
              </div>
              
              <div class="text-right">
                <p class="text-2xl font-bold text-green-600">$<%= number_with_delimiter(claim.prize_amount) %></p>
                <% case claim.status %>
                <% when 'pending' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                <% when 'auto_credited' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Auto-Credited</span>
                <% when 'manual_claim_required' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">Manual Required</span>
                <% when 'claimed' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Claimed</span>
                <% when 'expired' %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Expired</span>
                <% end %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Your Numbers</label>
                <p class="text-sm font-mono bg-gray-100 px-2 py-1 rounded"><%= claim.ticket.numbers_display %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Winning Numbers</label>
                <p class="text-sm font-mono bg-green-100 px-2 py-1 rounded text-green-800"><%= claim.draw.winning_numbers_display %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Claim Deadline</label>
                <p class="text-sm text-gray-900"><%= claim.claim_deadline.strftime("%b %d, %Y") %></p>
                <% if claim.days_until_expiration <= 30 && !claim.claimed? && !claim.expired? %>
                  <p class="text-xs text-red-600"><%= claim.days_until_expiration %> days left</p>
                <% end %>
              </div>
            </div>

            <div class="flex justify-between items-center pt-4 border-t border-gray-200">
              <div class="text-sm text-gray-600">
                <% if claim.tax_withholding_amount.present? %>
                  Net Amount: <span class="font-medium text-gray-900">$<%= number_with_delimiter(claim.net_prize_amount) %></span>
                  (Tax withholding: $<%= number_with_delimiter(claim.tax_withholding_amount) %>)
                <% else %>
                  Net Amount: <span class="font-medium text-gray-900">$<%= number_with_delimiter(claim.net_prize_amount) %></span>
                <% end %>
              </div>
              
              <div class="flex space-x-3">
                <%= link_to "View Details", prize_claim_path(claim), 
                           class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
                
                <% if claim.can_claim_prize? && claim.pending? %>
                  <%= link_to "Claim Prize", claim_prize_claim_path(claim), 
                             method: :post,
                             data: { confirm: "Claim your prize of $#{number_with_delimiter(claim.net_prize_amount)}?" },
                             class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No prize claims found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if params[:status].present? %>
            No prize claims match the selected filter.
          <% else %>
            You haven't won any prizes yet. Keep playing!
          <% end %>
        </p>
        <div class="mt-6">
          <%= link_to "Play Lottery Games", lottery_games_path, 
                     class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
