<% if @drawn_number.persisted? %>
  <%= turbo_stream.prepend "drawn_numbers" do %>
    <%= render "drawn_numbers/drawn_number", drawn_number: @drawn_number %>
  <% end %>
  
  <%= turbo_stream.update "number_draw_errors" do %>
    <div class="bg-green-50 p-4 rounded mb-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800">
            Number <%= @drawn_number.number %> successfully drawn!
          </p>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.update "number_draw_errors" do %>
    <%= render "drawn_numbers/errors", drawn_number: @drawn_number %>
  <% end %>
<% end %>
