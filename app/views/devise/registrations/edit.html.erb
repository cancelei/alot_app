<% content_for :title, "Edit Profile" %>

<div class="max-w-5xl mx-auto py-8 px-4 sm:px-6 lg:px-8" data-controller="profile">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Your Profile</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your account settings and preferences.</p>
  </div>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-8" }) do |f| %>
    <%= f.error_notification %>

    <!-- Account Information Section -->
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 bg-gray-50">
        <h3 class="text-lg leading-6 font-medium text-gray-900 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Account Information
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Your personal details and account settings.</p>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
          <!-- Username (Read-only) -->
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700">Username</label>
            <div class="mt-1">
              <input type="text" value="<%= resource.username %>" disabled class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 bg-gray-100 text-gray-500">
            </div>
            <p class="mt-1 text-xs text-gray-500">Usernames cannot be changed after registration</p>
          </div>

          <!-- Full Name -->
          <div class="sm:col-span-3">
            <%= f.input :name, 
                        required: true, 
                        wrapper_html: { class: 'mb-0' },
                        input_html: { class: 'mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' },
                        label_html: { class: 'block text-sm font-medium text-gray-700' } %>
          </div>

          <!-- Email -->
          <div class="sm:col-span-4">
            <%= f.input :email, 
                        required: true, 
                        wrapper_html: { class: 'mb-0' },
                        input_html: { class: 'mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' },
                        label_html: { class: 'block text-sm font-medium text-gray-700' } %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="sm:col-span-6">
              <div class="rounded-md bg-yellow-50 p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-yellow-800">Email Confirmation Pending</h3>
                    <div class="mt-2 text-sm text-yellow-700">
                      <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- Password Change Section -->
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 bg-gray-50">
        <h3 class="text-lg leading-6 font-medium text-gray-900 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Password
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Update your password or keep your current one.</p>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
        <div class="mb-4">
          <button type="button" class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" data-action="profile#togglePasswordFields">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            Change Password
          </button>
        </div>

        <div class="hidden" data-profile-target="passwordFields">
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
            <!-- New Password -->
            <div class="sm:col-span-3">
              <%= f.input :password,
                          hint: "Leave blank if you don't want to change it",
                          required: false,
                          wrapper_html: { class: 'mb-0' },
                          input_html: { 
                            class: 'mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm',
                            autocomplete: "new-password" 
                          },
                          label_html: { class: 'block text-sm font-medium text-gray-700' },
                          hint_html: { class: 'mt-1 text-xs text-gray-500' } %>
            </div>

            <!-- Password Confirmation -->
            <div class="sm:col-span-3">
              <%= f.input :password_confirmation,
                          required: false,
                          wrapper_html: { class: 'mb-0' },
                          input_html: { 
                            class: 'mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm',
                            autocomplete: "new-password" 
                          },
                          label_html: { class: 'block text-sm font-medium text-gray-700' } %>
            </div>

            <!-- Current Password -->
            <div class="sm:col-span-4">
              <%= f.input :current_password,
                          hint: "We need your current password to confirm your changes",
                          required: true,
                          wrapper_html: { class: 'mb-0' },
                          input_html: { 
                            class: 'mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm',
                            autocomplete: "current-password" 
                          },
                          label_html: { class: 'block text-sm font-medium text-gray-700' },
                          hint_html: { class: 'mt-1 text-xs text-gray-500' } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wallet Connection Section (Placeholder for Phase 2) -->
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 bg-gray-50">
        <h3 class="text-lg leading-6 font-medium text-gray-900 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          Blockchain Wallet
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Connect your blockchain wallet for enhanced features.</p>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
        <div class="rounded-md bg-blue-50 p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">Coming Soon</h3>
              <div class="mt-2 text-sm text-blue-700">
                <p>Wallet connection functionality will be available in Phase 2. Stay tuned!</p>
              </div>
            </div>
          </div>
        </div>

        <button type="button" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          Connect Wallet
        </button>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex justify-end">
      <button type="button" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3">
        <%= link_to "Cancel", :back %>
      </button>
      <%= f.button :submit, "Save Changes", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <div class="mt-10">
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 bg-red-50">
        <h3 class="text-lg leading-6 font-medium text-red-800 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Danger Zone
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-red-700">Irreversible actions that will affect your account.</p>
      </div>
      <div class="border-t border-red-200 px-4 py-5 sm:p-6">
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Delete Account</h4>
            <p class="mt-1 text-sm text-gray-500">Permanently delete your account and all associated data.</p>
          </div>
          <%= button_to "Delete Account", 
                        registration_path(resource_name), 
                        method: :delete, 
                        data: { turbo_confirm: "This action cannot be undone. All your data will be permanently deleted. Are you sure?" }, 
                        class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
        </div>
      </div>
    </div>
  </div>
</div>
