<div class="min-h-screen bg-gradient-to-b from-indigo-50 to-white flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="text-center text-3xl font-extrabold text-indigo-900 mb-6">Reset Your Password</h2>
    <p class="text-center text-sm text-gray-600 mb-8">
      Enter your email address and we'll send you instructions to reset your password
    </p>
  </div>

  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow-xl rounded-lg sm:px-10 border border-indigo-100">
      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= f.error_notification class: "p-4 mb-4 text-sm text-red-700 bg-red-100 rounded-lg" %>

        <div class="space-y-6">
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
            <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", 
                class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>

          <div>
            <%= f.button :submit, "Send Reset Instructions", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">Or return to</span>
          </div>
        </div>

        <div class="mt-6 flex justify-center space-x-4">
          <%= link_to "Sign in", new_session_path(resource_name), class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
          <%= link_to "Sign up", new_registration_path(resource_name), class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
        </div>
      </div>
    </div>
  </div>
</div>
